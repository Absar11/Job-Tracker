# ── Backend (Render) Environment Variables ────────────────────────────────────

# MongoDB connection string (leave blank to use local JSON fallback)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/job_tracker_pro?retryWrites=true&w=majority"

# JWT signing secret
JWT_SECRET="super_secret_jwt_key_job_tracker_pro_2026"

# SMTP Email settings (Gmail recommended)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="Job Tracker Pro <your-email@gmail.com>"

# Vercel frontend URL (for CORS — set this on Render after deploying to Vercel)
FRONTEND_URL="https://your-app.vercel.app"

# Set to "false" if frontend is hosted on Vercel (skips serving static files)
SERVE_FRONTEND="false"

NODE_ENV="production"
PORT="3000"


# ── Frontend (Vercel) Environment Variables ───────────────────────────────────

# Render backend URL (set this on Vercel after deploying backend to Render)
VITE_API_URL="https://your-backend.onrender.com"
